---
import Stop from './Stop.astro';
import GlassPanel from './GlassPanel.astro';
import Button from './Button.astro';
import { site } from '../data/site';
const c = site.contact;
const year = new Date().getFullYear();
---

<Stop kind="contact" side="center" id="contact" label={site.zones.contact} labelledby="contact-title">
  <GlassPanel class="contact">
    <h2 class="contact__title" id="contact-title">
      <span class="accent-text">{c.title}</span>
    </h2>
    <p class="contact__body">{c.body}</p>
    <Button size="lg" class="contact__discord" data-copy={site.discord} aria-describedby="discord-status">
      <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
        ></path>
      </svg>
      <span>{c.discordLabel}</span>
      <span class="contact__handle">{site.discord}</span>
    </Button>
    <p class="contact__status" id="discord-status" role="status" data-copy-status data-copied-text={c.discordCopied}></p>
  </GlassPanel>
</Stop>

<footer class="footer">
  <p>© {year} {site.brand}</p>
  <p>{site.footer.note}</p>
</footer>

<style>
  .contact {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .contact__title {
    font-size: var(--step-6);
    line-height: var(--lh-tight);
  }

  .contact__title span {
    padding-bottom: 0.08em;
  }

  .contact__body {
    max-width: var(--measure-copy);
    color: var(--c-muted);
    font-size: var(--step-1);
    line-height: var(--lh-snug);
  }

  .contact__icon {
    width: 1.4em;
    height: 1.4em;
    flex: none;
  }

  /* The handle sits in a small glass chip inside the button. */
  .contact__handle {
    padding: 0 var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--c-glass-strong);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .contact__status {
    min-height: var(--space-3);
    font-size: var(--step--1);
    color: var(--c-blue-deep);
    font-weight: var(--fw-medium);
  }

  /* Small, quiet sign-off under the last stop. */
  .footer {
    position: relative;
    display: grid;
    justify-items: center;
    gap: calc(var(--space-1) / 2);
    padding: var(--space-4) var(--gutter) var(--space-4);
    font-size: var(--step--1);
    color: var(--c-ink);
    text-align: center;
  }
</style>
