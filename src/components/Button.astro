---
/**
 * Glossy pill button / link-button (Frutiger-Aero "candy" plastic).
 * variant "primary" = the pastel-pink action. Use ONE per viewport.
 * variant "ghost"   = secondary action, frosted white.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg';
  href?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'> & { class?: string };

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...(Tag === 'button' ? { type: 'button' } : {})}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  <span class="btn__shine" aria-hidden="true"></span>
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--hit);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--step-0);
    color: var(--c-ink);
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    border: var(--border-glass) solid var(--c-glass-edge);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .btn__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .btn--lg {
    min-height: calc(var(--hit) + var(--space-1));
    padding-inline: var(--space-4);
    font-size: var(--step-1);
  }

  .btn--primary {
    background: var(--c-pink);
    box-shadow: var(--shadow-glow-pink);
  }

  .btn--primary:hover {
    background: var(--c-pink-hover);
    transform: translateY(var(--lift));
  }

  .btn--ghost {
    background: var(--c-glass-strong);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
  }

  .btn--ghost:hover {
    transform: translateY(var(--lift));
    box-shadow: var(--shadow-glow-blue);
  }

  /* Glossy candy highlight over the top half. */
  .btn__shine {
    position: absolute;
    inset: var(--border-w) var(--space-2) 50% var(--space-2);
    z-index: -1;
    border-radius: var(--radius-pill);
    background: var(--g-gloss);
    pointer-events: none;
  }

  .btn:active {
    transform: translateY(0) scale(0.98);
  }

  .btn:focus-visible {
    border-radius: var(--radius-pill);
  }
</style>
