---
/**
 * Glass card that tilts in 3D toward the cursor, with a moving glare.
 * Behaviour: src/scripts/animations/tilt.ts (hover-capable pointers only,
 * never under reduced motion). Otherwise it is a flat glass card.
 */
import GlassPanel from './GlassPanel.astro';
---

<div class="tilt" data-tilt data-reveal-item>
  <GlassPanel class="tilt__inner" size="sm" data-tilt-inner>
    <slot />
    <span class="tilt__glare" aria-hidden="true"></span>
  </GlassPanel>
</div>

<style>
  .tilt {
    height: 100%;
  }

  .tilt :global(.tilt__inner) {
    height: 100%;
    overflow: hidden;
    will-change: transform;
  }

  /* Oversized radial highlight; JS translates it to follow the cursor. */
  .tilt__glare {
    position: absolute;
    width: 200%;
    height: 200%;
    left: -50%;
    top: -50%;
    background: var(--g-glare);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-med) var(--ease-out);
  }

  .tilt:global(.is-tilting) .tilt__glare {
    opacity: 1;
  }
</style>
